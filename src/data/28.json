[{"id":1,"text":"Який зі способів буксирування заборонений на гірських дорогах?","hasImage":true,"options":[{"letter":"а","text":"Буксирування на гнучкому зчепленні.","correct":true},{"letter":"б","text":"Буксирування на жорсткому зчепленні.","correct":false},{"letter":"в","text":"Буксирування способом часткового навантаження.","correct":false},{"letter":"г","text":"Буксирування будь-яким способом.","correct":false}],"explanation":"На гірських дорогах заборонено: б) буксирування на гнучкому зчепленні.","image":"data:image/webp;base64,"},{"id":2,"text":"На гірських дорогах і крутих спусках, де зустрічний роз'їзд утруднено, дати дорогу повинен:","hasImage":false,"options":[{"letter":"а","text":"Водій транспортного засобу, що рухається на спуск.","correct":true},{"letter":"б","text":"Водій транспортного засобу, що рухається на підйом.","correct":false},{"letter":"в","text":"Водій транспортного засобу з найбільшими габаритами.","correct":false}],"explanation":"На гірських дорогах і крутих спусках, де зустрічний роз’їзд утруднений, водій транспортного засобу, що рухається на спуск, повинен дати дорогу транспортним засобам, що рухаються на підйом."},{"id":3,"text":"На гірських дорогах і крутих спусках, де зустрічний роз'їзд утруднено, перевагу в русі має:","hasImage":false,"options":[{"letter":"а","text":"Водій транспортного засобу, що рухається на спуск.","correct":false},{"letter":"б","text":"Водій транспортного засобу, що рухається на підйом.","correct":true},{"letter":"в","text":"Водій транспортного засобу з найбільшими габаритами.","correct":false}],"explanation":"На гірських дорогах і крутих спусках, де зустрічний роз’їзд утруднений, водій транспортного засобу, що рухається на спуск, повинен дати дорогу транспортним засобам, що рухаються на підйом."},{"id":4,"text":"Під час руху на спуск на вашій смузі руху виникла перешкода роз'їдетеся із зустрічним транспортним засобом?","hasImage":false,"options":[{"letter":"а","text":"Поступитеся йому дорогою.","correct":true},{"letter":"б","text":"Маючи перевагу в русі, проїдете першим.","correct":false}],"explanation":"Якщо зустрічний роз’їзд утруднений, водій, на смузі руху якого є перешкода чи габарити транспортного засобу, яким він керує, заважають зустрічному руху, повинен дати дорогу. На ділянках доріг, позначенихзнаками 1.6 «Крутий спуск» і 1.7 «Крутий підйом» за наявності перешкоди дати дорогу повинен водій транспортного засобу, який рухається на спуск."},{"id":5,"text":"Що з перерахованого забороняється на гірських дорогах?","hasImage":false,"options":[{"letter":"а","text":"Рухатися з непрацюючим двигуном.","correct":false},{"letter":"б","text":"Рухатися з вимкненими зчепленням або передачею.","correct":false},{"letter":"в","text":"Заборонені обидві дії, зазначені у відповідях 1 і 2.","correct":true}],"explanation":"На гірських дорогах заборонено: a) рухатися з непрацюючим двигуном та вимкненими зчепленням або передачею."},{"id":6,"text":"Під час руху по гірських дорогах водій транспортного засобу повинен:","hasImage":false,"options":[{"letter":"а","text":"Рухатися з працюючим двигуном, ввімкненими зчепленням і передачею.","correct":true},{"letter":"б","text":"Рухатися з працюючим двигуном.","correct":false},{"letter":"в","text":"Рухатися з ввімкненими зчепленням або передачею.","correct":false}],"explanation":"На гірських дорогах заборонено: a) рухатися з непрацюючим двигуном та вимкненими зчепленням або передачею."},{"id":7,"text":"Яким способом/способами дозволено буксирування автомобілів на гірських дорогах?","hasImage":false,"options":[{"letter":"а","text":"На жорсткому зчепленні.","correct":false},{"letter":"б","text":"На гнучкому зчепленні.","correct":false},{"letter":"в","text":"Способом часткового навантаження.","correct":false},{"letter":"г","text":"На жорсткому зчепленні або способом часткового навантаження.","correct":true}],"explanation":"На гірських дорогах заборонено: б) буксирування на гнучкому зчепленні."},{"id":8,"text":"Чи дозволене буксирування на гірських дорогах під час ожеледиці?","hasImage":false,"options":[{"letter":"а","text":"Заборонено.","correct":true},{"letter":"б","text":"Дозволено на жорсткому зчепленні.","correct":false},{"letter":"в","text":"Дозволено способом часткового навантаження.","correct":false}],"explanation":"На гірських дорогах заборонено: в) будь-яке буксирування під час ожеледиці."}]